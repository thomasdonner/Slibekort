# Postgres i EU-region (Neon eller Supabase, EU skal vælges aktivt)
DATABASE_URL=

# Auth.js — magisk link pr. mail, sendt via Resend herunder
AUTH_SECRET=

# Resend — klubbens eget domæne, SPF og DKIM skal være sat op
RESEND_API_KEY=
RESEND_FROM=

# Vises nederst i påmindelsesmails: "Ser noget forkert ud... skriv til"
KASSERER_KONTAKT_EMAIL=

# Systemets egen adresse, til at danne fulde links i mails (fx betalingslinket)
APP_URL=

# MobilePay ePayment API — nøgler fra forhandlerportalen under klubbens salgsenhed
# Testmiljø: https://apitest.vipps.no — produktion: https://api.vipps.no
MOBILEPAY_API_BASE_URL=https://apitest.vipps.no
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_SUBSCRIPTION_KEY=
MOBILEPAY_MERCHANT_SERIAL_NUMBER=
# Sat ved at køre: npm run mobilepay:webhook -- https://<dit-domæne>/api/mobilepay/webhook
MOBILEPAY_WEBHOOK_SECRET=
